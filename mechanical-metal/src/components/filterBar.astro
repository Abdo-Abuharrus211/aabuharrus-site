---
/**
 * TODO: On filter buttons toggle
 * Only show project cards with those tags
 * Highlight active toggles and dim inactive toggles
 */

const { tags } = Astro.props;
---

<div id="filter-box" class="container">
  <div id="filter-bar">
    <h3>Filter:</h3>
    {tags.map((tag: string) => (<button>{tag}</button>))}
    <!-- Add more when needed -->
  </div>
</div>

<style>
  #filter-bar {
    display: block;
  }
</style>
