---
import { turso } from "../data/turso";
import type { Skill } from "../types/types";

import SkillCard from "./skillCard.astro";
import SkillCarousel from "./skillCarousel.astro";
import type { Row } from "@libsql/client";

const sQuery = `
      SELECT s.id, s.name, s.icon
      FROM skills s
      LEFT JOIN skill_points sp ON sp.skill_id = s.id
      GROUP BY s.id`;

let skills: Skill[] = [];

try {
  const { rows: s_rows } = await turso.execute(sQuery);
  const { rows: sp_rows } = await turso.execute(
    `SELECT * FROM skill_points ORDER BY sort_order;`,
  );

  if (s_rows == null || s_rows.length <= 0) {
    console.error(
      `Error fetching skills: query returned no rows, skills might be null.`,
    );
  }
  if (sp_rows == null || sp_rows.length <= 0) {
    console.error(
      `Error fetching skill points: query returned no rows, skills might be null.`,
    );
  }

  skills = combineSkillPoints(s_rows, sp_rows);
} catch (error) {
  console.error(`Error fetching skills: ${error}`);
}

/**
 * Combine the Skills data with their respective keypoints
 * @param s_rows array of `Row` database results, representing skills
 * @param sp_rows array of `Row` database results, representing skills' points
 */
function combineSkillPoints(s_rows: Row[], sp_rows: Row[]): Skill[] {
  return s_rows.map((sr) => {
    const points: string[] = sp_rows
      ? sp_rows
          .filter((pz) => pz.skill_id === sr.id)
          .map((p) => p.point as string)
      : [];

    const newSkill: Skill = {
      id: sr.id as number,
      name: sr.name as string,
      icon: sr.icon as string,
      points,
    };
    return newSkill;
  });
}
---

<section id="Skills">
  <h1>SKILLS</h1>
  <p>Experienced in a variety of languages, frameworks, and dev tools.</p>
  <a class="btn" target="_blank" href="Abdulqadir_Abuharrus_Resume.pdf"
    >Resume</a
  >
  <div class="flex">
    {skills.map((skill: Skill) => <SkillCard skillProps={skill} />)}
  </div>
  <div class="center">
    <button id="skill-reset" class="outline-btn hidden" aria-hidden="true"
      >Reset</button
    >
    <p id="reset-msg" class="hidden" aria-hidden="true">Easy there!🫵✋🤌</p>
  </div>
  <SkillCarousel skills={skills}/>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const resetBtn = document.getElementById("skill-reset");
    const resetMsg = document.getElementById("reset-msg");
    let shownSkills = [];

    resetBtn.addEventListener("click", reset);

    /**
     * Remove the 'hidden' class from respective SkillCard to display details.
     *
     * @param element reference to DOM element to be made visible.
     */
    const unhide = (element) => {
      if (element && element.classList.contains("hidden")) {
        element.classList.remove("hidden");
        element.setAttribute("aria-hidden", "false");
      }
    };

    /**
     * Reset the array of visible SkillCards and hide them and the reset button.
     */
    function reset() {
      shownSkills.forEach((element) => {
        if (!element.classList.contains("hidden")) {
          element.classList.add("hidden");
          element.setAttribute("aria-hidden", "true");
        }
      });
      shownSkills = [];
      if (resetBtn) {
        resetBtn.classList.remove("bounce");
        resetBtn.classList.add("hidden");
        resetBtn.setAttribute("aria-hidden", "true");
      }
      if (resetMsg) {
        resetMsg.classList.add("hidden");
        resetMsg.setAttribute("aria-hidden", "true");
      }
      document
        .getElementById("Skills")
        .scrollIntoView({ behavior: "smooth", block: "center" });
    }

    const skillCards = document.querySelectorAll('[id^="skill-"]');
    const totalSkills = skillCards.length;

    // Attach listeners and handle carousel item clicks to make SkillCards visible
    document.querySelectorAll(".carousel-item").forEach((item) => {
      item.addEventListener("click", (e) => {
        const idx = parseInt(item.getAttribute("data-index"));
        if (isNaN(idx) || idx < 0) return;

        // Using modulo here because there are duplicates in the carousel due to it "looping"
        const skillIndex = idx % totalSkills;
        const newPopup = document.getElementById(`skill-${skillIndex}`);

        if (
          newPopup &&
          !shownSkills.includes(newPopup) &&
          shownSkills.length < 4
        ) {
          shownSkills.push(newPopup);
          unhide(newPopup);
        } else if (shownSkills.length >= 4) {
          if (resetMsg) {
            resetMsg.classList.remove("hidden");
            resetMsg.setAttribute("aria-hidden", "false");
          }
          if (resetBtn) resetBtn.classList.add("bounce");
        }
        if (resetBtn && shownSkills.length > 0) {
          resetBtn.classList.remove("hidden");
          resetBtn.setAttribute("aria-hidden", "false");
        }
      });
    });
  });
</script>
