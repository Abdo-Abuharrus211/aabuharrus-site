---
import { getCollection } from "astro:content";
import SkillCard from "./skillCard.astro";
import SkillCarousel from "./skillCarousel.astro";

const skills = await getCollection("skills");
---

<section id="Skills">
  <h1>SKILLS</h1>
  <p>I've experience with several languages,frameworks, and dev tools.</p>
  <a class="btn" target="_blank" href="Abdulqadir_Abuharrus_Resume.pdf"
    >Resume</a
  >
  <div class="flex">
    {skills.map((skill: any) => <SkillCard skillProps={skill} />)}
  </div>
  <div class="center">
    <button
      id="skill-reset"
      class="outline-btn hidden"
      onclick="reset()"
      aria-hidden="true">Reset</button
    >
    <p id="reset-msg" class="hidden" aria-hidden="true">Easy there!🫵✋🤌</p>
  </div>
  <SkillCarousel />
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const resetBtn = document.getElementById("skill-reset");
    const resetMsg = document.getElementById("reset-msg");
    let shownSkills = [];

    resetBtn.addEventListener("click", reset);

    /**
     * Remove the 'hidden' class from respective SkillCard to display details.
     *
     * @param element reference to DOM element to be made visible.
     */
    const unhide = (element) => {
      if (element && element.classList.contains("hidden")) {
        element.classList.remove("hidden");
        element.setAttribute("aria-hidden", "false");
      }
    };

    /**
     * Reset the array of visible SkillCards and hide them and the reset button.
     */
    function reset() {
      shownSkills.forEach((element) => {
        if (!element.classList.contains("hidden")) {
          element.classList.add("hidden");
          element.setAttribute("aria-hidden", "true");
        }
      });
      shownSkills = [];
      if (resetBtn) {
        resetBtn.classList.remove("bounce");
        resetBtn.classList.add("hidden");
        resetBtn.setAttribute("aria-hidden", "true");
      }
      if (resetMsg) {
        resetMsg.classList.add("hidden");
        resetMsg.setAttribute("aria-hidden", "true");
      }
      document
        .getElementById("Skills")
        .scrollIntoView({ behavior: "smooth", block: "start" });
    }

    const skillCards = document.querySelectorAll('[id^="skill-"]');
    const totalSkills = skillCards.length;

    // Attach listeners and handle carousel item clicks to make SkillCards visible
    document.querySelectorAll(".carousel-item").forEach((item) => {
      item.addEventListener("click", (e) => {
        const idx = parseInt(item.getAttribute("data-index"));
        if (isNaN(idx) || idx < 0) return;

        // Using modulo here because there are duplicates in the carousel due to it "looping"
        const skillIndex = idx % totalSkills;
        const newPopup = document.getElementById(`skill-${skillIndex}`);

        if (newPopup && !shownSkills.includes(newPopup) && shownSkills.length < 8) {
          shownSkills.push(newPopup);
          unhide(newPopup);
        } else if (shownSkills.length >= 8) {
          if (resetMsg) {
            resetMsg.classList.remove("hidden");
            resetMsg.setAttribute("aria-hidden", "false");
          }
          if (resetBtn) resetBtn.classList.add("bounce");
        }
        if (resetBtn && shownSkills.length > 0) {
          resetBtn.classList.remove("hidden");
          resetBtn.setAttribute("aria-hidden", "false");
        }
      });
    });
  });
</script>
