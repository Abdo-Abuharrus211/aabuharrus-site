---
import Image from "astro/components/Image.astro";
import bioHeadshot from "../images/cafe-roast-pfp.jpg";
import workPhoto from "../images/setup-2025.jpg";
import hobbyPhoto from "../images/Jackie.webp";
import eduPhoto from "../images/bcit-tech-collider.webp";
import About from "./about.svelte";

// Old bio layout is superseded by the tabbed <About /> component.
// Kept in the markup below for reference; flip to true to restore it.
const SHOW_OLD_BIO = false;
---

<!-- Build out the Bio -->
<section id="Bio">
  <h1>BIO</h1>
  <About
    whoImg={bioHeadshot.src}
    bgImg={eduPhoto.src}
    hobbyImg={hobbyPhoto.src}
    client:load
  />
  {/* Old bio markup kept for reference; replaced by the tabbed <About /> above */}
  {SHOW_OLD_BIO && (
  <div class="container flex column">
    <div class="bio-box flex">
      <div>
        <Image
          class:list={"bio-img"}
          src={bioHeadshot}
          alt={"Bio"}
          aria-label={"Headshot photo for Bio section"}
        />
      </div>
      <div>
        <h2>Background</h2>
        <p>
          Video games and old PCs sparked my interest in tech early on,<br
          />started coding Arduino boards and one thing lead to another.
        </p>
      </div>
    </div>

    <div class="bio-box flex reverse">
      <div>
        <Image class:list={"bio-img"} src={workPhoto} alt={"Work"} />
      </div>
      <div>
        <h2>What I do</h2>
        <div class="tag-box">
          <p class="tag">Full Stack</p>
          <p class="tag">Backend Systems</p>
          <p class="tag">Scripting</p>
          <p class="tag">CLI Tools</p>
          <p class="tag">Automated workflows</p>
        </div>
        {/* <button
          class="outline-btn"
          onclick="document.getElementById('Contact')?.scrollIntoView({behavior: 'smooth'});"
          >Let's chat</button> */}
      </div>
    </div>

    {/* <div class="bio-box flex">
      <div>
        <Image class:list={"bio-img"} src={eduPhoto} alt={"Education"} />
      </div>
      <div>
        <h2>Education</h2>
        <p>British Columbia Institute of Technology - (2023-2025)</p>
        <p>University of British Columbia - (2020-2022)</p>
        <p>Shuhada Al-Shat High School - (2017-2019)</p>
        <p>Kennedy-Lugar YES Exchange Program - (2017-2018)</p>
      </div>
    </div> */}

    <div class="bio-box flex reverse">
      <div>
        <Image
          class:list={"bio-img"}
          src={hobbyPhoto}
          alt={"Interests and Hobbies photographs"}
        />
      </div>
      <div>
        <h2>Interests</h2>
        <p>
          I've a ton! Details are in my <a href="https://garden.aabuharrus.dev/"
            >blog</a
          >.
        </p>
        <div class="tag-box">
          <p class="tag">Café-hopping</p>
          <p class="tag">Aquariums</p>
          <p class="tag">Guitar</p>
          <p class="tag">Sci-fi and Fantasy</p>
          <p class="tag">Wildlife & Automotive Photography</p>
        </div>
      </div>
    </div>
  </div>
  )}

  <style>
    .bio-img {
      height: 100%;
      width: 100%;
      object-fit: cover;
    }

    .hobbies-list {
      line-height: 2.5em;
    }
    .hobbies-list > li {
      display: inline;
    }
  </style>
</section>
