---
import Image from "astro/components/Image.astro";
const icon =
    "data:image/svg+xml;base64,";
---

<a id="to-top-btn" class="btn hidden" href="#Home">
    <img src={icon} alt="to-top" />
</a>

<script>
    var scrollPosition = 0;
    const topBtn = document.getElementById("to-top-btn");

    window.addEventListener("DOMContentLoaded", () => {
        const topBtn = document.getElementById("to-top-btn");
        const homeSection = document.getElementById("Home");

        function toggleButton() {
            if (!homeSection || !topBtn) return;

            const rect = homeSection.getBoundingClientRect();
            // If beyond the `Home` section and scrolling Up
            if (
                rect.bottom < 0 &&
                document.body.getBoundingClientRect().top > scrollPosition
            ) {
                topBtn.classList.remove("hidden");
            } else {
                topBtn.classList.add("hidden");
            }
            scrollPosition = document.body.getBoundingClientRect().top;
        }

        window.addEventListener("scroll", toggleButton);
        toggleButton(); // Initial check
    });
</script>

<style>
    #to-top-btn {
        position: sticky;
        top: 10%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        transition:
            opacity 0.3s ease,
            visibility 0.3s ease;
        white-space: nowrap;
        opacity: 0.7;
        padding: var(--spacing1);
        border-radius: var(--spacing3);
    }

    #to-top-btn:hover {
        opacity: 1;
    }

    /* Responsive adjustments */
    @media (max-width: 640px) {
        #top-button {
            top: 15%;
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
        }
    }
</style>
