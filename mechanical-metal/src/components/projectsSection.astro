---
/**
 * This Astro component's a wrapper around the Svelte islands, which I used for modal interactivity.
 * I kept this comp because of the ease of data retrieval using Astro's `getCollection` and content management.
 * Pass the data to the Svelte gallery as a prop, it then renders the flex box display of cards.
 */

import { getCollection } from "astro:content";
import ProjectGallery from "../components/projectGallery.svelte";
import FilterBar from "./filterBar.astro";
import FeatureProject from "./featureProject.astro";

const projects = await getCollection("projects");
const featuredProjects = projects.filter((p) => p.data.featured);
// removes the featured from the rest
featuredProjects.map((p) =>{
  projects.splice(projects.indexOf(p),1)
})

const tags = [
  "Systems",
  "Full Stack",
  "Backend",
  "Frontend",
  "Rust",
  "Python",
  "JS/TS",
];
---

<section id="Projects">
  <h1>PROJECTS</h1>
  <div class="featured-showcase">
    <h3>Featured</h3>
    {featuredProjects.map((proj: any) => <FeatureProject data={proj} />)}
  </div>
  <FilterBar tags={tags} />
  <!-- Pass the data to the island -->
  <ProjectGallery client:load="svelte" projects={projects} />
</section>

<style>
  .showcase {
    position: relative;
    border: 0.5px solid var(--accent);
    border-radius: 12px;
    overflow: hidden;
  }

  .proj-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    align-items: flex-start;
  }
</style>
