---
/**
 * Projects section with featured carousel and filterable gallery.
 * Featured projects are displayed in an auto-rotating carousel at the top.
 * Remaining projects are displayed in a filterable grid below.
 */

import { getCollection } from "astro:content";
import ProjectGallery from "../components/projectGallery.svelte";
import FilterBar from "./filterBar.astro";
import FeaturedProjectCarousel from "./FeaturedProjectCarousel.svelte";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects.filter((p) => p.data.featured);

// Remove featured projects from the main gallery
const galleryProjects = allProjects.filter((p) => !p.data.featured);

const tags = [
  "Systems",
  "Full Stack",
  "Backend",
  "Frontend",
  "Rust",
  "Python",
  "JS/TS",
];
---

<section id="Projects">
  <h1>PROJECTS</h1>
  
  {featuredProjects.length > 0 && (
  <div class="featured-showcase">
    <h3>Featured</h3>
      <FeaturedProjectCarousel client:load projects={featuredProjects} />
  </div>
  )}
  
  <FilterBar tags={tags} />
  <!-- Pass the data to the island -->
  <ProjectGallery client:load="svelte" projects={galleryProjects} />
</section>

<style>
  .showcase {
    position: relative;
    border: 0.5px solid var(--accent);
    border-radius: 12px;
    overflow: hidden;
  }

  .proj-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    align-items: flex-start;
  }
</style>
