---
import { Image } from "astro:assets";
import bannerBG from "../images/silver-dunes.webp";
---

<div id="Home">
  <!-- <Image src={bannerBG} alt="Background" class="bg-image" /> -->
  <!-- <img
    src="/src/images/blurry-gradient-haikei.svg"
    alt="Background"
    class="bg-image"
  /> -->
  <div class="flex padding2">
    <div class="flex column">
      <div class="greeting-box1">
        <h1 class="greeting">،أهلًا</h1>
      </div>
      <div class="greeting-box2">
        <h1 class="greeting">HI,</h1>
      </div>

      <div class="intro-box">
        <h2 class="banner-text">I'm Abdu, a Software Developer</h2>
        <p>
          I build Backend heavy systems, Full Stack apps, automate boring tasks,
          and create tools that improve UX & DX.
        </p>
        <div>
          <!-- &gt; is the esc char for '>' -->
          <button
            class="code-highlight outline-btn"
            onclick="document.getElementById('Bio')?.scrollIntoView({ behavior: 'smooth' });"
            ><span class="code-text">~abdu&gt; run -f </span>
          </button>
          <a
            href="https://github.com/Abdo-Abuharrus211"
            target="_blank"
            aria-label="Github url"
          >
            <svg
              class="icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/aabuharrus/"
            target="_blank"
            aria-label="Linkedin url"
          >
            <svg
              class="icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div class="visual-box">
      <Image class:list={"banner-img"} src={bannerBG} alt="banner" />
      <small
        >// Not much of a web/graphic designer, so here's one of my favourite
        photos that I've ever taken.</small
      >
    </div>
  </div>
</div>

<style>
  #Home {
    padding: 10%;
    height: 100dvh;
    width: 100dvw;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* #Home img.bg-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
      filter: blur(4px);
    } */
  .greeting {
    font-size: clamp(2.5rem, 9vw, 10rem);
    font-weight: 400;
  }

  .greeting-box1 {
    margin-left: 20%;
  }

  .greeting-box2 {
    align-self: flex-start;
  }

  .intro-box {
    padding: 0%;
    text-align: start;
    align-self: center;
  }
  .intro-box button,
  a {
    font-size: var(--fsize2);
    margin-right: var(--spacing2);
  }
  .intro-box button {
    position: relative;
    border-bottom: 2px solid var(--primary);
    overflow: hidden;
  }

  /* Gives it the glowing signal effect */
  .intro-box button::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent), 0 0 12px var(--accent);
    animation: signal-left-right 4s ease-in-out infinite;
    animation-direction: alternate;
  }
  @keyframes signal-left-right {
    0% {
      width: 0%;
      left: 0;
    }
    45% {
      width: 100%;
      left: 0;
    }
    50% {
      width: 100%;
      left: auto;
      right: 0;
    }
    95% {
      width: 0%;
      left: auto;
      right: 0;
    }
    100% {
      width: 0%;
      left: 0;
      right: auto;
    }
  }
  .visual-box {
    margin-top: var(--spacing3);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .banner-img {
    width: 100%;
    height: auto;
    max-width: fit-content;
  }
  @media (max-width: 900px) {
    #Home {
      margin-top: var(--spacing6);
      padding: 5%;
      height: auto;
      width: 100vw;
    }
    .greeting {
      font-size: 4rem;
      margin: 0 var(--spacing3);
    }
    .intro-box {
      align-self: center;
    }
    .intro-box button {
      margin-bottom: 1rem;
    }
  }
  @media (max-width: 768px) {
    #Home {
      padding: 4%;
      height: auto;
      justify-content: flex-start;
      flex-direction: column;
    }
    .greeting {
      font-size: 3.5rem;
      text-align: center;
    }
    .greeting-box1, .greeting-box2 {
      margin: 0 auto;
    }
    .intro-box {
      padding: 3%;
    }
    .visual-box {
      margin-top: 2rem;
    }
  }

  @media (max-width: 480px) {
    #Home {
      padding: 3%;
    }
    .greeting {
      font-size: 3rem;
    }
    .intro-box button {
      font-size: 0.9rem;
    }
    .banner-img {
      max-width: 90%;
    }
  }
</style>
